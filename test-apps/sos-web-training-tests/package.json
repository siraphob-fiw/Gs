{
  "name": "@strengthos/sos-web-training-tests",
  "version": "1.0.0",
  "description": "Test application for sos-web-training - Isolated testing environment for Next.js frontend",
  "author": "Human Digital Solutions Co Ltd",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --passWithNoTests",
    "test:unit": "jest --testPathPattern=src/unit --passWithNoTests --testTimeout=30000",
    "test:unit:watch": "jest --testPathPattern=src/unit --watch --passWithNoTests",
    "test:unit:cov": "jest --testPathPattern=src/unit --coverage --passWithNoTests",
    "test:component": "jest --testPathPattern=src/**/*.component.test.tsx --passWithNoTests --testTimeout=45000",
    "test:component:watch": "jest --testPathPattern=src/**/*.component.test.tsx --watch --passWithNoTests",
    "test:component:cov": "jest --testPathPattern=src/**/*.component.test.tsx --coverage --passWithNoTests",
    "test:integration": "jest --testPathPattern=src/integration --passWithNoTests --testTimeout=60000 --runInBand",
    "test:integration:watch": "jest --testPathPattern=src/integration --watch --passWithNoTests --runInBand",
    "test:integration:cov": "jest --testPathPattern=src/integration --coverage --passWithNoTests --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:smoke": "jest --testPathPattern=src/**/*.smoke.test.ts --passWithNoTests --testTimeout=60000",
    "test:perf": "playwright test --grep=\"@performance\"",
    "test:fast": "jest --testPathPattern=\"src/unit|src/**/*.component.test.tsx|src/**/*.smoke.test.ts\" --passWithNoTests --testTimeout=45000",
    "test:slow": "npm run test:integration && npm run test:e2e",
    "test:all": "npm run test:unit && npm run test:component && npm run test:integration && npm run test:e2e",
    "test:ci": "jest --coverage --passWithNoTests --ci --watchAll=false --testTimeout=60000 && playwright test --reporter=html",
    "test:report": "jest --coverage --passWithNoTests --reporters=default --reporters=jest-html-reporters && playwright test --reporter=html",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .next coverage test-results playwright-report",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix"
  },
  "dependencies": {
    "@strengthos/sos-web-training": "file:../../apps/sos-web-training",
    "@strengthos/shared-testing": "file:../../libs/shared-testing"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}