{
  "name": "@strengthos/sos-web-api-tests",
  "version": "1.0.0",
  "description": "Test application for sos-web-api - Isolated testing environment",
  "author": "Human Digital Solutions Co Ltd",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --passWithNoTests",
    "test:unit": "jest --testPathPattern=src/unit --passWithNoTests --testTimeout=30000",
    "test:unit:watch": "jest --testPathPattern=src/unit --watch --passWithNoTests",
    "test:unit:cov": "jest --testPathPattern=src/unit --coverage --passWithNoTests",
    "test:integration": "jest --testPathPattern=src/integration --passWithNoTests --testTimeout=60000 --runInBand",
    "test:integration:watch": "jest --testPathPattern=src/integration --watch --passWithNoTests --runInBand",
    "test:integration:cov": "jest --testPathPattern=src/integration --coverage --passWithNoTests --runInBand",
    "test:e2e": "jest --testPathPattern=src/e2e --passWithNoTests --testTimeout=120000 --runInBand",
    "test:e2e:watch": "jest --testPathPattern=src/e2e --watch --passWithNoTests --runInBand",
    "test:e2e:cov": "jest --testPathPattern=src/e2e --coverage --passWithNoTests --runInBand",
    "test:api": "jest --testPathPattern=src/**/*.api.test.ts --passWithNoTests --testTimeout=60000 --runInBand",
    "test:smoke": "jest --testPathPattern=src/**/*.smoke.test.ts --passWithNoTests --testTimeout=60000",
    "test:perf": "jest --testPathPattern=src/**/*.perf.test.ts --passWithNoTests --testTimeout=300000 --runInBand",
    "test:fast": "jest --testPathPattern=\"src/unit|src/**/*.smoke.test.ts\" --passWithNoTests --testTimeout=30000",
    "test:slow": "jest --testPathPattern=\"src/integration|src/e2e|src/**/*.perf.test.ts\" --passWithNoTests --testTimeout=300000 --runInBand",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:ci": "jest --coverage --passWithNoTests --ci --watchAll=false --testTimeout=60000",
    "test:report": "jest --coverage --passWithNoTests --reporters=default --reporters=jest-html-reporters",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/platform-express": "^11.1.6",
    "@strengthos/shared-testing": "file:../../libs/shared-testing",
    "@strengthos/sos-web-api": "file:../../apps/sos-web-api"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^29.5.2",
    "@types/node": "^22.10.2",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.5.0",
    "prettier": "^3.6.2",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.0",
    "rxjs": "^7.8.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
