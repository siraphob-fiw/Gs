{
  "name": "@strengthos/sos-web-api",
  "version": "1.0.0",
  "description": "StrengthOS Web API - NestJS-based REST API for the StrengthOS platform",
  "author": "Human Digital Solutions Co Ltd",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/sos-web-api/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --passWithNoTests",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
    "test:unit": "jest --testPathPattern=src --passWithNoTests",
    "test:integration": "jest --testPathPattern=test --testNamePattern=integration --passWithNoTests",
    "test:compatibility": "ts-node test/compatibility/compatibility-test-runner.ts",
    "test:compatibility:api": "jest --testPathPattern=test/compatibility/api-compatibility.spec.ts --passWithNoTests",
    "test:compatibility:tokens": "jest --testPathPattern=test/compatibility/token-compatibility.spec.ts --passWithNoTests",
    "test:compatibility:tenants": "jest --testPathPattern=test/compatibility/tenant-isolation.spec.ts --passWithNoTests",
    "test:final-integration": "jest --testPathPattern=test/integration/final-integration.integration.spec.ts --passWithNoTests",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:compatibility",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "db:migrate": "ts-node scripts/migrate.ts",
    "db:rollback": "ts-node scripts/rollback.ts",
    "db:seed": "ts-node scripts/seed.ts",
    "db:status": "ts-node scripts/db-status.ts",
    "db:generate": "knex migrate:make --knexfile knexfile.ts",
    "db:migrate:knex": "knex migrate:latest --knexfile knexfile.ts",
    "db:rollback:knex": "knex migrate:rollback --knexfile knexfile.ts",
    "db:seed:knex": "knex seed:run --knexfile knexfile.ts"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^2.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/terminus": "^10.0.0",
    "@nestjs/throttler": "^5.0.0",
    "@strengthos/shared-cache": "file:../../libs/shared-cache",
    "@strengthos/shared-database": "file:../../libs/shared-database",
    "@strengthos/shared-external": "file:../../libs/shared-external",
    "@strengthos/shared-logging": "file:../../libs/shared-logging",
    "@strengthos/shared-middleware": "file:../../libs/shared-middleware",
    "@strengthos/shared-monitoring": "file:../../libs/shared-monitoring",
    "@strengthos/shared-notifications": "file:../../libs/shared-notifications",
    "@strengthos/shared-security": "file:../../libs/shared-security",
    "@strengthos/shared-testing": "file:../../libs/shared-testing",
    "@strengthos/shared-types": "file:../../libs/shared-types",
    "@strengthos/shared-utils": "file:../../libs/shared-utils",
    "@strengthos/shared-validation": "file:../../libs/shared-validation",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^5.1.0",
    "cache-manager": "^5.0.0",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "helmet": "^7.0.0",
    "joi": "^17.9.0",
    "knex": "^3.0.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "reflect-metadata": "^0.1.13",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.7.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/joi": "^17.2.3",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^3.0.9",
    "@types/passport-local": "^1.0.35",
    "@types/pg": "^8.10.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
