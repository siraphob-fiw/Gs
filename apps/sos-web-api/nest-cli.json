{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.json",
    "assets": [],
    "watchAssets": true,
    "webpack": false,
    "preserveWatchOutput": true
  },
  "monorepo": false,
  "root": "."
}