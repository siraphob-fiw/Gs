{
  "name": "@strengthos/sos-web-api",
  "version": "1.0.0",
  "description": "StrengthOS Web API - NestJS-based REST API for the StrengthOS platform",
  "author": "Human Digital Solutions Co Ltd",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/apps/sos-web-api/src/main",
    "start:dev": "node dist/apps/sos-web-api/src/main --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/sos-web-api/src/main.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "db:migrate": "ts-node scripts/migrate.ts",
    "db:rollback": "ts-node scripts/rollback.ts",
    "db:seed": "ts-node scripts/seed.ts",
    "db:status": "ts-node scripts/db-status.ts",
    "db:generate": "knex migrate:make --knexfile knexfile.ts",
    "db:migrate:knex": "knex migrate:latest --knexfile knexfile.ts",
    "db:migrate:file": "knex migrate:up --knexfile knexfile.ts --name",
    "db:rollback:knex": "knex migrate:rollback --knexfile knexfile.ts",
    "db:seed:knex": "knex seed:run --knexfile knexfile.ts",
    "get-tenants": "ts-node scripts/get-tenants.ts"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.5",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@strengthos/shared-cache": "file:../../libs/shared-cache",
    "@strengthos/shared-database": "file:../../libs/shared-database",
    "@strengthos/shared-external": "file:../../libs/shared-external",
    "@strengthos/shared-logging": "file:../../libs/shared-logging",
    "@strengthos/shared-middleware": "file:../../libs/shared-middleware",
    "@strengthos/shared-monitoring": "file:../../libs/shared-monitoring",
    "@strengthos/shared-notifications": "file:../../libs/shared-notifications",
    "@strengthos/shared-security": "file:../../libs/shared-security",
    "@strengthos/shared-types": "file:../../libs/shared-types",
    "@strengthos/shared-utils": "file:../../libs/shared-utils",
    "@strengthos/shared-validation": "file:../../libs/shared-validation",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^5.1.1",
    "boxen": "^5.1.2",
    "cache-manager": "^7.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "google-auth-library": "^9.15.1",
    "helmet": "^7.0.0",
    "joi": "^17.9.0",
    "keyv": "^5.5.5",
    "knex": "^3.0.0",
    "mailgun.js": "^12.1.0",
    "nodemailer": "^6.10.1",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pause": "^0.0.1",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "reflect-metadata": "^0.1.13",
    "swagger-ui-dist": "^5.21.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.7.2",
    "@types/express": "^4.17.17",
    "@types/joi": "^17.2.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^3.0.9",
    "@types/passport-local": "^1.0.35",
    "@types/pg": "^8.10.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
