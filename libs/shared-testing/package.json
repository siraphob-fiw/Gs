{
  "name": "@strengthos/shared-testing",
  "version": "1.0.0",
  "description": "Shared testing utilities, factories, and mocks for StrengthOS applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "create-test-app": "node dist/cli/create-test-app.js",
    "create-test-app:help": "node dist/cli/create-test-app.js help"
  },
  "bin": {
    "create-test-app": "dist/cli/create-test-app.js"
  },
  "dependencies": {
    "@strengthos/shared-types": "file:../shared-types",
    "@strengthos/shared-utils": "file:../shared-utils",
    "@strengthos/shared-database": "file:../shared-database",
    "@strengthos/shared-logging": "file:../shared-logging",
    "uuid": "^9.0.1",
    "@faker-js/faker": "^8.4.1",
    "vitest": "^1.2.2",
    "supertest": "^6.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/uuid": "^9.0.8",
    "@types/supertest": "^6.0.2",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^29.5.2",
    "jest": "^29.5.0",
    "typescript": "^5.9.2",
    "rimraf": "^5.0.5"
  },
  "peerDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "@nestjs/testing": "^11.0.0",
    "jest": "^29.0.0"
  }
}