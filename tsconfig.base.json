{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@strengthos/shared-types": ["libs/shared-types/src/index.ts"],
      "@strengthos/shared-types/*": ["libs/shared-types/src/*"],
      "@strengthos/shared-utils": ["libs/shared-utils/src/index.ts"],
      "@strengthos/shared-utils/*": ["libs/shared-utils/src/*"],
      "@strengthos/shared-logging": ["libs/shared-logging/src/index.ts"],
      "@strengthos/shared-logging/*": ["libs/shared-logging/src/*"],
      "@strengthos/shared-validation": ["libs/shared-validation/src/index.ts"],
      "@strengthos/shared-validation/*": ["libs/shared-validation/src/*"],
      "@strengthos/shared-security": ["libs/shared-security/src/index.ts"],
      "@strengthos/shared-security/*": ["libs/shared-security/src/*"],
      "@strengthos/shared-cache": ["libs/shared-cache/src/index.ts"],
      "@strengthos/shared-cache/*": ["libs/shared-cache/src/*"],
      "@strengthos/shared-database": ["libs/shared-database/src/index.ts"],
      "@strengthos/shared-database/*": ["libs/shared-database/src/*"],
      "@strengthos/shared-middleware": ["libs/shared-middleware/src/index.ts"],
      "@strengthos/shared-middleware/*": ["libs/shared-middleware/src/*"],
      "@strengthos/shared-external": ["libs/shared-external/src/index.ts"],
      "@strengthos/shared-external/*": ["libs/shared-external/src/*"],
      "@strengthos/shared-monitoring": ["libs/shared-monitoring/src/index.ts"],
      "@strengthos/shared-monitoring/*": ["libs/shared-monitoring/src/*"],
      "@strengthos/shared-notifications": ["libs/shared-notifications/src/index.ts"],
      "@strengthos/shared-notifications/*": ["libs/shared-notifications/src/*"],
      "@strengthos/shared-i18n": ["libs/shared-i18n/src/index.ts"],
      "@strengthos/shared-i18n/*": ["libs/shared-i18n/src/*"],
      "@strengthos/shared-testing": ["libs/shared-testing/src/index.ts"],
      "@strengthos/shared-testing/*": ["libs/shared-testing/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}